#!/usr/bin/env bash
set -Eeuo pipefail
cd /opt/i-clusters
exec 9>/run/iclusters-updater.lock
flock -n 9 || exit 0
mkdir -p runtime /var/lib/iclusters-updater
check_id=$(python3 -c 'import json; print(json.load(open("runtime/update-check.json")).get("checkId", ""))' 2>/dev/null || true)
rm -f runtime/update-check.json
current=$(git rev-parse HEAD)
latest=$current
available=false
state=ready
message='Up to date.'
# Keep a previously detected release visible while the next fetch is in progress.
prior_latest=$(python3 -c 'import json,re; s=json.load(open("/var/lib/iclusters-updater/update-status.json")); v=s.get("latest", ""); print(v if s.get("available") and re.fullmatch(r"[a-fA-F0-9]{7,40}", v) else "")' 2>/dev/null || true)
if [[ -n $prior_latest && $prior_latest != "$current" ]]; then latest=$prior_latest; available=true; fi
write_status() {
  printf '{"current":"%s","latest":"%s","available":%s,"state":"%s","message":"%s","checkedAt":"%s","checkId":"%s"}\n' "$current" "$latest" "$available" "$state" "$message" "$(date -u +%FT%TZ)" "$check_id" > /var/lib/iclusters-updater/update-status.json.tmp
  mv /var/lib/iclusters-updater/update-status.json.tmp /var/lib/iclusters-updater/update-status.json
}
trap 'rm -f runtime/update-request.json; state=failed; message="Update failed. Run sudo journalctl -u iclusters-updater -n 100 on Ubuntu."; write_status' ERR
if ! git symbolic-ref --quiet HEAD >/dev/null; then
  message='Pinned release: update manually on Ubuntu.'
  rm -f runtime/update-request.json
  write_status
  exit 0
fi
state=checking; message='Checking GitHub for updates...'; write_status
timeout 90 git fetch --quiet origin
state=ready; message='Up to date.'
latest=$(git rev-parse '@{upstream}')
available=false
if [[ $current != "$latest" ]]; then available=true; message='A new update is available.'; fi
if [[ -f runtime/update-request.json ]]; then
  rm runtime/update-request.json
  if [[ $available == true ]]; then
    state=updating; message='Downloading and rebuilding. The dashboard will reconnect automatically.'; write_status
    /usr/local/bin/iclusters update
    current=$(git rev-parse HEAD)
    available=false; state=completed; message='Update installed.'
  fi
fi
write_status
