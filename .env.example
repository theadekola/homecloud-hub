# Public URL
DOMAIN=:80
WEB_ORIGIN=http://localhost

# Initial administrator. CHANGE BEFORE FIRST START.
ADMIN_EMAIL=admin@homecloud.local
ADMIN_PASSWORD=ChangeMe-Now-Strong-Password-123!
JWT_SECRET=replace-with-at-least-64-random-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-64-random-characters
JWT_REFRESH_EXPIRES_IN=7d

# Database
POSTGRES_DB=homecloud
POSTGRES_USER=homecloud
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://homecloud:replace-with-a-long-random-password@postgres:5432/homecloud

# API
PORT=4000
TRUST_PROXY=1
CONNECTOR_TIMEOUT_MS=15000
ACTION_TIMEOUT_MS=300000

# Proxmox (optional until connected)
PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_TLS=true
PROXMOX_DEFAULT_STORAGE=local-lvm

# Docker Engine (optional until connected)
# Strongly prefer HTTPS + mTLS or a private SSH/agent gateway.
DOCKER_API_URL=
DOCKER_TLS_CA=
DOCKER_TLS_CERT=
DOCKER_TLS_KEY=

# TrueNAS: JSON-RPC for newer SCALE, legacy WebSocket for CORE/older SCALE.
TRUENAS_URL=
TRUENAS_API_KEY=
TRUENAS_API_MODE=jsonrpc
TRUENAS_WS_PATH=
TRUENAS_TLS_CA=

# OPNsense API key/secret. URLs must use HTTPS.
OPNSENSE_URL=
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
OPNSENSE_TLS_CA=
OPNSENSE_API_STYLE=current

# Tailscale admin API; not the device enrollment/auth key.
TAILSCALE_TAILNET=
TAILSCALE_API_KEY=

# Other services: optional HTTP health endpoints, configured by the server owner.
SERVICE_CHECKS_JSON=[]

# AI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
